# Copy outside git as /etc/m4a/core.env (0640 root:m4a). Placeholders only.
M4A_SERVER_NAME=<server-name>            # the identity of this instance; never changes
M4A_CORE_BIND=<core-wg-ip>:8741          # the wg-msg address of the core, never a wildcard
M4A_STATE_DIR=/var/lib/m4a
M4A_RETENTION=on
M4A_EVENT_TTL_DAYS=14
M4A_LOCAL_NAMES=<comma-list-of-entry-hostnames>
M4A_PUBLIC_BASE_URL=<https://entry-host>   # served at /.well-known/matrix/client (through the edge)
M4A_FEDERATION_DELEGATE=                  # empty until federation exists
# Generated on the host, never in git/chat:
# M4A_DB_KEY_HEX=...
# M4A_EDGE_SECRET=...   (>= 32 chars, same value as on the edge)
